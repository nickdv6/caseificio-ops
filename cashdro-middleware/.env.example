# ---- CashDro S (static IP on the shop LAN, HTTP API enabled in its web console)
CASHDRO_HOST=192.168.1.50
CASHDRO_USER=admin
CASHDRO_PASSWORD=change-me
CASHDRO_TIMEOUT_S=180          # customer must finish inserting cash within 3 min
CASHDRO_POLL_INTERVAL_S=1.0
CASHDRO_SALE_TYPE=1            # VERIFY against the CashDro3WS manual

# ---- Epson FP-81 II RT
# true  = this middleware prints the documento commerciale (disable the fiscal
#         printer inside Shopify POS for this register, or you get two receipts)
# false = Shopify POS prints it when the cashier taps Cash; middleware only
#         drives the recycler
EPSON_ENABLED=true
EPSON_HOST=192.168.1.60
EPSON_DEVID=local_printer
EPSON_OPERATOR=1
EPSON_TIMEOUT_MS=15000
# VAT % → fiscal department programmed on the printer
VAT_DEPARTMENTS=22:1,10:2,4:3
EPSON_CASH_LABEL=CONTANTI
ROUND_CASH_TO_5C=false

# ---- Security
AUTH_MODE=session_token        # session_token | hmac | both | none (dev only)
SHOPIFY_API_KEY=               # from the custom app in Partners / Dev Dashboard
SHOPIFY_API_SECRET=            # same app's client secret (signs POS session tokens)
HMAC_SECRET=                   # only if AUTH_MODE includes hmac; mirror in CheckoutExtension.jsx
ALLOWED_ORIGINS=https://extensions.shopifycdn.com,https://cdn.shopify.com,null
ALLOWED_CLIENT_IPS=            # optional, e.g. 192.168.1.21,192.168.1.22 (the iPads)

# ---- Server
PORT=8443
SSL_CERTFILE=certs/pos-bridge.fabula.lan.pem
SSL_KEYFILE=certs/pos-bridge.fabula.lan-key.pem
JOURNAL_DB=/var/lib/cashdro/journal.sqlite
STORE_NAME=Latteria Fabula
LOG_LEVEL=INFO

# ---- Scale (CE-M counter scale; see SCALE.md)
SCALE_ENABLED=false
SCALE_TRANSPORT=tcp            # tcp | serial
SCALE_PORT=192.168.1.70:4001   # or /dev/tty.usbserial-XXXX
SCALE_BAUD=9600
SCALE_MODE=poll                # poll | stream
SCALE_REQUEST_CMD=W\r\n
SCALE_STABLE_READS=3           # only used if the protocol has no ST/US token
SCALE_MIN_KG=0.005
SCALE_PRODUCTS_FILE=products_a_peso.json
